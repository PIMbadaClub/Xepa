@model IReadOnlyList<DenunciaAdminDto>
@{
    ViewData["Title"] = "Denúncias";
    var todas = ViewData["Todas"] as bool? ?? false;
}
<h1>Denúncias</h1>
<p class="sub">Enviadas pelos clientes em cada pedido. A resposta aparece para o cliente no app.</p>

<nav class="filtros" aria-label="Filtrar denúncias">
    <a asp-action="Denuncias" class="@(!todas ? "ativo" : "")">Em análise</a>
    <a asp-action="Denuncias" asp-route-todas="true" class="@(todas ? "ativo" : "")">Todas</a>
</nav>

@if (Model.Count == 0)
{
    <div class="cartao vazio">Nenhuma denúncia @(todas ? "registrada" : "em análise"). Tudo tranquilo por aqui.</div>
}
@foreach (var d in Model)
{
    <article class="cartao denuncia">
        <header>
            <div>
                <strong>@Rotulos.Motivo(d.Motivo)</strong>
                <span class="selo @(d.Status switch { StatusDenuncia.Aberta => "sacola", StatusDenuncia.Procedente => "perigo", _ => "inativa" })">@Rotulos.Denuncia(d.Status)</span>
                @if (d.Motivo == MotivoDenuncia.Discriminacao) { <span class="selo perigo">Prioridade</span> }
            </div>
            <span class="sub" style="margin:0;font-size:13px">#@d.Id · pedido #@d.PedidoId · @Rotulos.Data(d.CriadoEm)</span>
        </header>
        <p class="sub" style="margin:6px 0 0">
            <strong>@d.Cliente</strong>@(d.ClienteBloqueado ? " (suspenso)" : "") sobre <strong>@d.Loja</strong>@(d.LojaAtiva ? "" : " (suspensa)")
        </p>
        <blockquote>@d.Descricao</blockquote>

        @if (d.Status == StatusDenuncia.Aberta)
        {
            <form asp-action="TratarDenuncia" asp-route-id="@d.Id" method="post" class="tratar">
                <div class="campo">
                    <label for="resposta-@d.Id">Resposta para o cliente</label>
                    <textarea id="resposta-@d.Id" name="resposta" rows="2" required maxlength="1000"
                              placeholder="Ex.: Conversamos com a loja e o valor foi estornado."></textarea>
                </div>
                <label class="caixa"><input type="checkbox" name="suspenderLoja" value="true" /> Suspender a loja (só se procedente)</label>
                <div class="acoes">
                    <button class="botao pequeno" type="submit" name="decisao" value="@StatusDenuncia.Procedente">Procedente</button>
                    <button class="botao secundario pequeno" type="submit" name="decisao" value="@StatusDenuncia.Improcedente">Improcedente</button>
                </div>
            </form>
            <form asp-action="AlterarBloqueio" asp-route-id="@d.ClienteId" method="post" class="acoes" style="margin-top:8px">
                <input type="hidden" name="bloqueado" value="@(d.ClienteBloqueado ? "false" : "true")" />
                <input type="hidden" name="voltar" value="Denuncias" />
                <button class="botao secundario pequeno" type="submit">@(d.ClienteBloqueado ? "Liberar o cliente" : "Suspender o cliente (denúncia abusiva)")</button>
            </form>
        }
        else
        {
            <p class="resposta"><strong>Resposta:</strong> @d.Resposta <span class="sub" style="font-size:12px">· @(d.TratadaEm is { } t ? Rotulos.Data(t) : "")</span></p>
        }
    </article>
}
