@model IReadOnlyList<LojaAdminDto>
@{
    ViewData["Title"] = "Lojas";
    var filtro = ViewData["Filtro"] as StatusCadastro?;
}
<h1>Lojas</h1>
<p class="sub">Só lojas aprovadas e ativas aparecem no app (RN10). Suspender tira a loja e as ofertas do ar.</p>

<nav class="filtros" aria-label="Filtrar por situação">
    <a asp-action="Lojas" class="@(filtro is null ? "ativo" : "")">Todas</a>
    @foreach (var s in Enum.GetValues<StatusCadastro>())
    {
        <a asp-action="Lojas" asp-route-status="@s" class="@(filtro == s ? "ativo" : "")">@Rotulos.Cadastro(s)</a>
    }
</nav>

@if (Model.Count == 0)
{
    <div class="cartao vazio">Nenhuma loja por aqui.</div>
}
else
{
    <table>
        <thead>
            <tr><th scope="col">Loja</th><th scope="col">Responsável</th><th scope="col">Endereço</th><th scope="col">Histórico</th><th scope="col">Situação</th><th scope="col">Ações</th></tr>
        </thead>
        <tbody>
            @foreach (var l in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Loja" asp-route-id="@l.Id" class="linha-link">@l.Nome</a>
                        <div class="mini">@Rotulos.Categoria(l.Categoria) · CNPJ @(l.Cnpj ?? "—")</div>
                        <div class="mini">desde @Rotulos.Data(l.CriadoEm)</div>
                    </td>
                    <td>@l.Responsavel<div class="mini">@l.Email · @(l.Telefone ?? "sem telefone")</div></td>
                    <td>
                        @l.Bairro, @l.Cidade
                        @if (!l.TemCoordenadas) { <div><span class="selo sacola">Sem coordenadas</span></div> }
                    </td>
                    <td>
                        @l.Pedidos entregue(s)
                        @if (l.DenunciasProcedentes > 0) { <div><span class="selo perigo">@l.DenunciasProcedentes denúncia(s) procedente(s)</span></div> }
                    </td>
                    <td>
                        <span class="selo @(l.Status switch { StatusCadastro.Aprovado => "ativa", StatusCadastro.Pendente => "sacola", _ => "inativa" })">@Rotulos.Cadastro(l.Status)</span>
                        @if (!l.Ativa) { <span class="selo perigo">Suspensa</span> }
                    </td>
                    <td>
                        <div class="acoes">
                            <a asp-action="Loja" asp-route-id="@l.Id" class="botao secundario pequeno">Editar</a>
                            @if (l.Status == StatusCadastro.Pendente)
                            {
                                <form asp-action="AvaliarLoja" asp-route-id="@l.Id" method="post">
                                    <input type="hidden" name="aprovar" value="true" />
                                    <button class="botao pequeno" type="submit">Aprovar</button>
                                </form>
                                <form asp-action="AvaliarLoja" asp-route-id="@l.Id" method="post">
                                    <input type="hidden" name="aprovar" value="false" />
                                    <button class="botao secundario pequeno" type="submit">Rejeitar</button>
                                </form>
                            }
                            else if (l.Status == StatusCadastro.Aprovado)
                            {
                                <form asp-action="AlterarLoja" asp-route-id="@l.Id" method="post">
                                    <input type="hidden" name="ativa" value="@(l.Ativa ? "false" : "true")" />
                                    <button class="botao secundario pequeno" type="submit">@(l.Ativa ? "Suspender" : "Reativar")</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
