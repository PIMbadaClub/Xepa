@model CadastroLojaForm
@{
    ViewData["Title"] = "Cadastre sua loja";
}
<section class="cartao login cadastro" aria-labelledby="titulo-cadastro">
    <div class="login-topo">
        <img src="~/img/tomate.svg" asp-append-version="true" alt="" class="tomate-fundo" />
        <div class="marca" aria-hidden="true"><span class="selo-marca"><img src="~/img/tomate.svg" asp-append-version="true" alt="" /></span><img src="~/img/xepa-nome-branco.svg" alt="Xepa" class="nome" /></div>
        <h1 id="titulo-cadastro">Cadastre sua loja</h1>
        <p>Venda o que sobrou do dia em vez de jogar fora. A equipe da XEPA confere os dados antes de a loja aparecer no app.</p>
    </div>
    <form asp-action="Cadastrar" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <h2 class="secao">A loja</h2>
        <div class="grade">
            <div class="campo">
                <label asp-for="NomeLoja"></label>
                <input asp-for="NomeLoja" placeholder="Ex.: Padaria Pão Dourado" />
                <span asp-validation-for="NomeLoja" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Categoria"></label>
                <select asp-for="Categoria">
                    @foreach (var c in Enum.GetValues<CategoriaEstabelecimento>())
                    {
                        <option value="@c">@Rotulos.Categoria(c)</option>
                    }
                </select>
            </div>
            <div class="campo">
                <label asp-for="Cnpj"></label>
                <input asp-for="Cnpj" inputmode="numeric" placeholder="00.000.000/0000-00" />
                <span asp-validation-for="Cnpj" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Telefone"></label>
                <input asp-for="Telefone" type="tel" placeholder="(11) 99999-9999" />
                <span asp-validation-for="Telefone" class="erro"></span>
            </div>
        </div>

        <h2 class="secao">Endereço de retirada</h2>
        <div class="grade">
            <div class="campo">
                <label asp-for="Cep"></label>
                <input asp-for="Cep" inputmode="numeric" placeholder="00000-000" />
                <span asp-validation-for="Cep" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Logradouro"></label>
                <input asp-for="Logradouro" />
                <span asp-validation-for="Logradouro" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Numero"></label>
                <input asp-for="Numero" />
                <span asp-validation-for="Numero" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Bairro"></label>
                <input asp-for="Bairro" />
                <span asp-validation-for="Bairro" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Cidade"></label>
                <input asp-for="Cidade" />
                <span asp-validation-for="Cidade" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Uf"></label>
                <input asp-for="Uf" maxlength="2" />
                <span asp-validation-for="Uf" class="erro"></span>
            </div>
        </div>

        <h2 class="secao">Acesso ao portal</h2>
        <div class="grade">
            <div class="campo">
                <label asp-for="Responsavel"></label>
                <input asp-for="Responsavel" autocomplete="name" />
                <span asp-validation-for="Responsavel" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="username" />
                <span asp-validation-for="Email" class="erro"></span>
            </div>
            <div class="campo">
                <label asp-for="Senha"></label>
                <input asp-for="Senha" autocomplete="new-password" />
                <span class="ajuda">Mínimo de 8 caracteres.</span>
                <span asp-validation-for="Senha" class="erro"></span>
            </div>
        </div>

        <div class="campo aceite">
            <label class="caixa">
                <input asp-for="AceitouTermos" />
                <span>Li e aceito os <a asp-controller="Legal" asp-action="Termos" target="_blank">termos de uso</a> e a <a asp-controller="Legal" asp-action="Privacidade" target="_blank">política de privacidade</a> da XEPA.</span>
            </label>
            <span asp-validation-for="AceitouTermos" class="erro"></span>
        </div>

        <button type="submit" class="botao" style="width:100%">Enviar cadastro</button>
        <p class="sub" style="text-align:center;margin:16px 0 0">Já tem conta? <a asp-action="Entrar">Entrar</a></p>
    </form>
</section>
