@model EntrarForm
@{
    ViewData["Title"] = "Entrar";
}
<section class="cartao login" aria-labelledby="titulo-login">
    <div class="login-topo">
        <img src="~/img/tomate.svg" alt="" class="tomate-fundo" />
        <div class="marca" aria-hidden="true"><span class="selo-marca"><img src="~/img/tomate.svg" alt="" /></span>xepa</div>
        <h1 id="titulo-login">Portal do estabelecimento</h1>
        <p>Publique o que sobrou, acompanhe os pedidos e salve comida do lixo.</p>
    </div>
    <form asp-action="Entrar" method="post" novalidate>
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="campo">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" autofocus />
            <span asp-validation-for="Email" class="erro"></span>
        </div>
        <div class="campo">
            <label asp-for="Senha"></label>
            <input asp-for="Senha" autocomplete="current-password" />
            <span asp-validation-for="Senha" class="erro"></span>
        </div>
        <button type="submit" class="botao" style="width:100%">Entrar</button>
    </form>
</section>
