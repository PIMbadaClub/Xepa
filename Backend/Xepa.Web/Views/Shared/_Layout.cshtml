@inject Xepa.Application.Suporte.SuporteService Suporte
@{
    var logado = User.Identity?.IsAuthenticated == true;
    var admin = User.IsInRole(nameof(TipoUsuario.Administrador));
    var loja = User.FindFirst(ContaController.ClaimEstabelecimentoNome)?.Value;
    var statusLoja = User.FindFirst(ContaController.ClaimEstabelecimentoStatus)?.Value;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string Ativo(string c, string? a = null) => controller == c && (a is null || action == a) ? "ativo" : "";
    string? Atual(string c, string? a = null) => controller == c && (a is null || action == a) ? "page" : null;

    // Bolinha do suporte: conversas esperando a equipe (admin) ou respostas que a loja ainda não viu.
    var suporteNaoLidas = !logado ? 0
        : admin ? await Suporte.NaoLidasEquipeAsync(Context.RequestAborted)
        : loja is not null ? await Suporte.NaoLidasAsync(int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value), Context.RequestAborted)
        : 0;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · XEPA</title>
    <link rel="icon" type="image/svg+xml" href="~/img/tomate.svg" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    @if (logado)
    {
        <div class="app">
            <nav class="lateral" aria-label="Menu principal">
                <div class="marca"><img src="~/img/tomate.svg" asp-append-version="true" alt="" class="tomate" /><img src="~/img/xepa-nome.svg" asp-append-version="true" alt="Xepa" class="nome" /></div>
                @if (admin)
                {
                    <div class="contexto"><span class="chip-admin">Administração</span></div>
                    <a asp-controller="Admin" asp-action="Painel" class="@Ativo("Admin", "Painel")" aria-current="@Atual("Admin", "Painel")">@Icones.Svg("painel")Painel</a>
                    <a asp-controller="Admin" asp-action="Pedidos" class="@(controller == "Admin" && action is "Pedidos" or "Pedido" ? "ativo" : "")">@Icones.Svg("pedidos")Pedidos</a>
                    <a asp-controller="Admin" asp-action="Lojas" class="@(controller == "Admin" && action is "Lojas" or "Loja" ? "ativo" : "")">@Icones.Svg("lojas")Lojas</a>
                    <a asp-controller="Admin" asp-action="Entregadores" class="@Ativo("Admin", "Entregadores")" aria-current="@Atual("Admin", "Entregadores")">@Icones.Svg("entregadores")Entregadores</a>
                    <a asp-controller="Admin" asp-action="Usuarios" class="@(controller == "Admin" && action is "Usuarios" or "Usuario" ? "ativo" : "")">@Icones.Svg("usuarios")Usuários</a>
                    <a asp-controller="Admin" asp-action="Denuncias" class="@Ativo("Admin", "Denuncias")" aria-current="@Atual("Admin", "Denuncias")">@Icones.Svg("denuncias")Denúncias</a>
                    <a asp-controller="Admin" asp-action="Suporte" class="@(controller == "Admin" && action is "Suporte" or "Conversa" ? "ativo" : "")">@Icones.Svg("suporte")<span>Suporte</span>@if (suporteNaoLidas > 0) { <span class="contador">@suporteNaoLidas</span> }</a>
                    <a asp-controller="Admin" asp-action="Repasses" class="@Ativo("Admin", "Repasses")" aria-current="@Atual("Admin", "Repasses")">@Icones.Svg("repasses")Repasses</a>
                }
                else
                {
                    <div class="contexto">Portal do estabelecimento@(loja is null ? "" : " · " + loja)</div>
                    <a asp-controller="Loja" asp-action="Inicio" class="@Ativo("Loja", "Inicio")" aria-current="@Atual("Loja", "Inicio")">@Icones.Svg("inicio")Início</a>
                    <a asp-controller="Pedidos" asp-action="Index" class="@Ativo("Pedidos")" aria-current="@Atual("Pedidos")">@Icones.Svg("pedidos")Pedidos</a>
                    <a asp-controller="Ofertas" asp-action="Index" class="@Ativo("Ofertas")" aria-current="@Atual("Ofertas")">@Icones.Svg("ofertas")Ofertas</a>
                    <a asp-controller="Impacto" asp-action="Index" class="@Ativo("Impacto")" aria-current="@Atual("Impacto")">@Icones.Svg("impacto")Impacto e vendas</a>
                    <a asp-controller="Loja" asp-action="Configuracoes" class="@Ativo("Loja", "Configuracoes")" aria-current="@Atual("Loja", "Configuracoes")">@Icones.Svg("config")Configurações</a>
                    <a asp-controller="Loja" asp-action="Suporte" class="@Ativo("Loja", "Suporte")" aria-current="@Atual("Loja", "Suporte")">@Icones.Svg("suporte")<span>Ajuda e suporte</span>@if (suporteNaoLidas > 0) { <span class="contador">@suporteNaoLidas</span> }</a>
                }
                <img src="~/img/tomate.svg" asp-append-version="true" alt="" class="tomate-escondido" />
                <form asp-controller="Conta" asp-action="Sair" method="post" class="sair">
                    <button type="submit">@Icones.Svg("sair")<span>Sair<small>@User.Identity!.Name</small></span></button>
                </form>
            </nav>
            <main id="conteudo" class="conteudo">
                @if (statusLoja == nameof(StatusCadastro.Pendente))
                {
                    <p class="faixa-pendente" role="status">Sua loja está em análise pela equipe da XEPA. Você já pode cadastrar ofertas; elas aparecem no app depois da aprovação.</p>
                }
                else if (statusLoja == nameof(StatusCadastro.Rejeitado))
                {
                    <p class="faixa-pendente" role="status">O cadastro da loja não foi aprovado. Fale com o suporte da XEPA para revisar os dados.</p>
                }
                @if (TempData["Mensagem"] is string mensagem)
                {
                    <p class="aviso" role="status">@mensagem</p>
                }
                @if (TempData["Erro"] is string erroGeral && controller != "Pedidos")
                {
                    <div class="validation-summary-errors" role="alert"><ul><li>@erroGeral</li></ul></div>
                }
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main id="conteudo" class="centro">
            @if (TempData["Erro"] is string erroPublico)
            {
                <div class="validation-summary-errors aviso-topo" role="alert"><ul><li>@erroPublico</li></ul></div>
            }
            @RenderBody()
        </main>
    }
</body>
</html>
